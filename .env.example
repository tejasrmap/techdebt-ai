# ==========================================
# TechDebt AI - Production Environment Configuration
# ==========================================

# 1. Environment & Mode
ENVIRONMENT=production
PROJECT_NAME="TechDebt AI"
API_V1_STR="/api/v1"
ENABLE_DEMO_SEED=false

# 2. Cryptographic Secrets (MUST be configured; at least 32 characters)
SECRET_KEY=replace-with-at-least-32-char-random-jwt-secret-key-prod
ENCRYPTION_KEY=replace-with-at-least-32-char-random-fernet-key-prod
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 3. Database Credentials (PostgreSQL / Supabase)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-db-password-in-production
POSTGRES_DB=techdebt_db
# Optional Supabase Integration
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional Razorpay Payment Gateway Integration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=USD
VITE_RAZORPAY_KEY_ID=

# 4. CORS Origins (Strict comma-separated list of allowed production domains)
CORS_ORIGINS=http://localhost,http://localhost:80,https://techdebt.yourdomain.com

# 5. Multi-Tenant Integration Configuration
ALLOW_PLATFORM_INTEGRATION_FALLBACK=false

# Optional Platform Fallback Keys (If ALLOW_PLATFORM_INTEGRATION_FALLBACK=true)
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL="https://api.firecrawl.dev/v1"
GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_AI_PROVIDER="gemini"
AI_MODEL_NAME="gemini-1.5-flash"
